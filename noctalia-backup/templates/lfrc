# Noctalia template for lfrc
# {{colors.primary.default.hex}} → "#F2A65A" → R:242 G:166 B:90

# ── Noctalia theme format strings ──
# To convert hex → ANSI 24-bit:  \033[38;2;R;G;Bm  (fg)  \033[48;2;R;G;Bm  (bg)
# Hex substitution values from Noctalia:
#   primary:    {{colors.primary.default.hex}}
#   on_primary: {{colors.on_primary.default.hex}}
#   secondary:  {{colors.secondary.default.hex}}
#   surface:    {{colors.surface.default.hex}}
#   on_surface: {{colors.on_surface.default.hex}}
#   surface_container: {{colors.surface_container.default.hex}}
#   surface_variant:   {{colors.surface_variant.default.hex}}
#   on_surface_variant: {{colors.on_surface_variant.default.hex}}
#   error:      {{colors.error.default.hex}}
#   on_error:   {{colors.on_error.default.hex}}
#   outline:    {{colors.outline.default.hex}}

set cursoractivefmt "\033[48;2;SURFACE_VARIANT_R;SURFACE_VARIANT_G;SURFACE_VARIANT_Bm\033[38;2;PRIMARY_R;PRIMARY_G;PRIMARY_Bm"
set cursorparentfmt "\033[48;2;SURFACE_VARIANT_R;SURFACE_VARIANT_G;SURFACE_VARIANT_Bm\033[38;2;ON_SURFACE_R;ON_SURFACE_G;ON_SURFACE_Bm"
set copyfmt "\033[48;2;SURFACE_VARIANT_R;SURFACE_VARIANT_G;SURFACE_VARIANT_Bm\033[38;2;SECONDARY_R;SECONDARY_G;SECONDARY_Bm"
set cutfmt "\033[48;2;SURFACE_VARIANT_R;SURFACE_VARIANT_G;SURFACE_VARIANT_Bm\033[38;2;ERROR_R;ERROR_G;ERROR_Bm"
set selectfmt "\033[48;2;OUTLINE_R;OUTLINE_G;OUTLINE_Bm\033[38;2;PRIMARY_R;PRIMARY_G;PRIMARY_Bm"
set visualfmt "\033[48;2;SURFACE_VARIANT_R;SURFACE_VARIANT_G;SURFACE_VARIANT_Bm\033[38;2;SECONDARY_R;SECONDARY_G;SECONDARY_Bm"
set tagfmt "\033[38;2;PRIMARY_R;PRIMARY_G;PRIMARY_Bm"
set errorfmt "\033[48;2;ERROR_R;ERROR_G;ERROR_Bm\033[38;2;ON_ERROR_R;ON_ERROR_G;ON_ERROR_Bm"
set promptfmt "\033[38;2;PRIMARY_R;PRIMARY_G;PRIMARY_Bm%u@%h\033[0m:\033[38;2;ON_SURFACE_VARIANT_R;ON_SURFACE_VARIANT_G;ON_SURFACE_VARIANT_Bm%d\033[0m\033[1m%f\033[0m"
set menufmt "\033[38;2;ON_SURFACE_R;ON_SURFACE_G;ON_SURFACE_Bm"
set menuheaderfmt "\033[1m\033[38;2;PRIMARY_R;PRIMARY_G;PRIMARY_Bm"
set menuselectfmt "\033[48;2;PRIMARY_R;PRIMARY_G;PRIMARY_Bm\033[38;2;ON_PRIMARY_R;ON_PRIMARY_G;ON_PRIMARY_Bm"
set statfmt "\033[38;2;SECONDARY_R;SECONDARY_G;SECONDARY_Bm%p\033[0m| %c| %u| %g| %S| %t| -> %l"
set numberfmt "\033[38;2;ON_SURFACE_R;ON_SURFACE_G;ON_SURFACE_Bm"
