{
  "manifest": {
    "api_version": 1,
    "id": "noctalia",
    "name": "Noctalia",
    "version": "1.0.0",
    "author": "kabir",
    "license": "MIT",
    "source": "",
    "kind": "theme"
  },
  "theme": {
    "dark": {
      "colors": {
        "base": "{{ colors.surface_container_lowest.default.hex }}",
        "sidebar": "{{ colors.surface_container_low.default.hex }}",
        "chat": "{{ colors.background.default.hex }}",
        "raised": "{{ colors.surface_container.default.hex }}",
        "hover": "{{ colors.on_surface.default.hex }}15",
        "selected": "{{ colors.on_surface.default.hex }}28",
        "border": "{{ colors.outline.default.hex }}",
        "text_strong": "{{ colors.on_surface.default.hex }}",
        "text": "{{ colors.on_surface.default.hex }}",
        "muted": "{{ colors.on_surface_variant.default.hex }}",
        "link": "{{ colors.tertiary.default.hex }}",
        "accent": "{{ colors.primary.default.hex }}",
        "accent_text": "{{ colors.on_primary.default.hex }}",
        "positive": "{{ colors.secondary.default.hex }}",
        "warning": "{{ colors.tertiary.default.hex }}",
        "danger": "{{ colors.error.default.hex }}",
        "mention_bg": "{{ colors.primary_container.default.hex }}",
        "mention_text": "{{ colors.on_primary_container.default.hex }}"
      }
    },
    "style": {
      "body_size": 15,
      "heading_size": 20,
      "button_size": 14,
      "small_size": 12,
      "monospace_size": 14,
      "item_spacing": [8, 8],
      "button_padding": [12, 6],
      "control_height": 32,
      "widget_radius": 0,
      "window_radius": 0,
      "menu_radius": 0
    }
  }
}
